# Files that are read on the Linux VM (profiles, scripts, workflows, sources) must keep LF line endings even when edited on Windows.
* text=auto
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.vue text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.png binary
*.jpg binary
*.mp4 binary
*.mp3 binary
*.ogg binary
*.glb binary
*.fbx binary
