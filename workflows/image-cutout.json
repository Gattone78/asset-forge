{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Load FLUX.1 schnell"},
        "inputs": {"unet_name": "flux1-schnell.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "DualCLIPLoader", "_meta": {"title": "Load text encoders"},
        "inputs": {"clip_name1": "t5xxl_fp16.safetensors", "clip_name2": "clip_l.safetensors", "type": "flux"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "Load VAE"},
        "inputs": {"vae_name": "ae.safetensors"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt"},
        "inputs": {"clip": ["2", 0], "text": "a sprite"}},
  "5": {"class_type": "ConditioningZeroOut", "_meta": {"title": "Negative (zeroed)"},
        "inputs": {"conditioning": ["4", 0]}},
  "6": {"class_type": "EmptySD3LatentImage", "_meta": {"title": "Latent"},
        "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "7": {"class_type": "KSampler", "_meta": {"title": "Sampler"},
        "inputs": {"model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["6", 0],
                   "seed": 1, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "8": {"class_type": "VAEDecode", "_meta": {"title": "Decode"},
        "inputs": {"samples": ["7", 0], "vae": ["3", 0]}},
  "9": {"class_type": "LoadBackgroundRemovalModel", "_meta": {"title": "Load BiRefNet"},
        "inputs": {"bg_removal_name": "birefnet.safetensors"}},
  "10": {"class_type": "RemoveBackground", "_meta": {"title": "Subject mask"},
        "inputs": {"bg_removal_model": ["9", 0], "image": ["8", 0]}},
  "11": {"class_type": "InvertMask", "_meta": {"title": "Mask to alpha"},
        "inputs": {"mask": ["10", 0]}},
  "12": {"class_type": "JoinImageWithAlpha", "_meta": {"title": "Cut out"},
        "inputs": {"image": ["8", 0], "alpha": ["11", 0]}},
  "13": {"class_type": "SaveImage", "_meta": {"title": "Save"},
        "inputs": {"images": ["12", 0], "filename_prefix": "jobs/unset/out/image"}},
  "14": {"class_type": "SaveImage", "_meta": {"title": "Save original"},
        "inputs": {"images": ["8", 0], "filename_prefix": "jobs/unset/refs/original"}}
}
